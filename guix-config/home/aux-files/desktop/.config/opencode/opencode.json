{
  "$schema": "https://opencode.ai/config.json",
  "model": "aitunnel/claude-sonnet-5.5",
  "small_model": "aitunnel/deepseek-v4.1-flash",
  "provider": {
    "aitunnel": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AITUNNEL",
      "options": {
        "baseURL": "https://api.aitunnel.ru/v1"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-6.1-terra": {
          "name": "GPT-6.1 Terra",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "claude-sonnet-5.5": {
          "name": "Claude Sonnet 5.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "kimi-k3.1-pro": {
          "name": "Kimi K3.1 Pro",
          "limit": {
            "context": 1048576,
            "output": 262144
          }
        },
        "glm-5.3": {
          "name": "GLM 5.3",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        }
      }
    }
  },
  "agent": {
    "plan": {
      "model": "aitunnel/gpt-6.1-terra"
    },
    "build": {
      "model": "aitunnel/claude-sonnet-5.5"
    },
    "general": {
      "model": "aitunnel/gpt-6.1-sol"
    },
    "explore": {
      "model": "aitunnel/deepseek-v4.1-flash"
    }
  },
  "permission": {
    "websearch": "allow",
    "webfetch": "allow"
  }
}
