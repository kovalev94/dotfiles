INTERNAL_MONITOR="eDP-1"

# Функция для настройки размера шрифта alacritty
function change_font_size(){
    ## If alacritty.yml does not exist, raise an alert
    [[ ! -f ~/.config/alacritty/alacritty.yml ]] && \
            notify-send "alacritty.yml does not exist" && exit 0
            
    ## Fetch background_opacity from alacritty.yml
    font_size=$(awk '$1 == "size:" {print $2; exit}' \
            ~/.config/alacritty/alacritty.yml)
            
    toggle_font_size=$1
                            
    ## Replace opacity value in alacritty.yml
    sed -i -- "s/size: $font_size/size: $toggle_font_size/" \
                                    ~/.config/alacritty/alacritty.yml
}

# Определяем режимы и настройки мониторов
function work_mode(){
    #change_font_size 11
    xrandr --output $INTERNAL_MONITOR --off
    xrandr --output $1 --auto
    xrandr --output $2 --auto
    xrandr --output $1 --left-of $2
    xrandr --dpi 96
    herbstclient detect_monitors
    echo "Xft.dpi:96" | xrdb -load
    SCALE_FACTOR=1
}

function home_tv_mode(){
    xrandr --output $1 --mode 4096x2160
    xrandr --output $INTERNAL_MONITOR --off
    herbstclient detect_monitors
    herbstclient add_monitor 2048x1080+0+0
    herbstclient add_monitor 2048x1080+2048+0
    herbstclient add_monitor 2048x1080+2048+1080
    herbstclient add_monitor 2048x1080+0+1080
    herbstclient remove_monitor 0
    herbstclient set show_frame_decorations all
    echo "Xft.dpi:96" | xrdb -load
    SCALE_FACTOR=1
}

function laptop_mode(){
    #change_font_size 7
    #xrandr --output DP-1-1 --off
    #xrandr --output DP-1-2 --off
    xrandr --auto
    xrdb -merge /home/kovalev/.Xresources
    xrandr --output $INTERNAL_MONITOR --dpi 192
    echo "Xft.dpi:192" | xrdb -load
    herbstclient detect_monitors
    SCALE_FACTOR=2
}


# В зависимости от количества подключенных мониторов выбираем режим

mapfile -t connected_monitors < <(xrandr | grep -w connected | grep -v $INTERNAL_MONITOR | awk '{print $1}')
if [[ ${#connected_monitors[*]} = 2 ]]
    then work_mode ${connected_monitors[@]}
elif [[ ${#connected_monitors[*]} = 1 ]]
    then home_tv_mode ${connected_monitors[@]}
elif [[ ${#connected_monitors[*]} = 0 ]]
    then laptop_mode ${connected_monitors[@]}
fi
echo $SCALE_FACTOR
