#!/bin/sh

WALLPAPER=$HOME/Pictures/japan-city-anime.jpg
ENABLE_PICOM=true

[ -f /etc/xprofile ] && . /etc/xprofile
[ -f ~/.xprofile ] && . ~/.xprofile

feh --no-fehbg --bg-scale $WALLPAPER

#turn on picom
if $ENABLE_PICOM; then
        picom \
                --blur-method=gaussian \
                --blur-size=20 \
                --blur-deviation=15 \
                --blur-strength=5 \
                --backend=glx \
                -b
fi

echo "Xft.dpi:192" | xrdb -load
xrdb -merge ~/.Xresources

exwm -mm
