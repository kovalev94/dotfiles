/* ROUNDED THEME FOR ROFI */
/* Author: Newman Sanchez (https://github.com/newmanls) */

* {
    font:   "Roboto 12";

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0mm;
    padding:    0mm;
    spacing:    0mm;
}

window {
    location:       north;
    y-offset:       calc(50% - 75mm);
    width:          160mm;
    border-radius:  8mm;

    background-color:   @bg0;
}

mainbox {
    padding:    12mm;
}

inputbar {
    background-color:   @bg1;
    border-color:       @bg3;

    border:         1mm;
    border-radius:  8mm;

    padding:    4mm 4mm;
    spacing:    4mm;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @fg2;
}

entry {
    placeholder:        "Search";
    placeholder-color:  @fg3;
}

message {
    margin:             6mm 0 0;
    border-radius:      8mm;
    border-color:       @bg2;
    background-color:   @bg2;
}

textbox {
    padding:    4mm 6mm;
}

listview {
    background-color:   transparent;

    margin:     6mm 0 0;
    lines:      8;
    columns:    1;

    fixed-height: false;
}

element {
    padding:        4mm 8mm;
    spacing:        4mm;
    border-radius:  8mm;
}

element normal active {
    text-color: @bg3;
}

element alternate active {
    text-color: @bg3;
}

element selected normal, element selected active {
    background-color:   @bg3;
}

element-icon {
    size:           1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}
